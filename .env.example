# Copy to .env and fill in. NEVER commit .env.
# JWT signing key (>= 32 chars). Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Field-encryption key(s), comma separated; the FIRST encrypts, all can decrypt (key rotation).
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
DATABASE_URL=postgresql://auth_user:change-me@localhost:5432/auth_db

# Optional tuning (defaults shown)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=20
TRUSTED_PROXY_COUNT=0
